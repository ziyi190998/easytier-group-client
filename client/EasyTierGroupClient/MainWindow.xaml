<Window x:Class="EasyTierGroupClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyTier 群友客户端" Height="600" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#1B1D24" Foreground="#E6E8EF">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 状态 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,10">
            <Ellipse x:Name="StateDot" Width="18" Height="18" Fill="#8A8F9C"/>
            <TextBlock x:Name="StateText" Text="未连接" FontSize="22" FontWeight="Bold"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="DetailText" Grid.Row="1" FontSize="12" Foreground="#9AA0AC"
                   TextWrapping="Wrap" Margin="0,0,0,14" MinHeight="16"/>

        <!-- 信息面板 -->
        <Border Grid.Row="2" Background="#232733" CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="K"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="我的虚拟 IP" Foreground="#9AA0AC" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="IpText" Text="—" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="开服服务器" Foreground="#9AA0AC" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ServerText" Text="—" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="已连接时长" Foreground="#9AA0AC" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DurationText" Text="—" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="↓ 收到流量" Foreground="#9AA0AC" Margin="0,0,24,10"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RxText" Text="—" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="↑ 发送流量" Foreground="#9AA0AC" Margin="0,0,24,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxText" Text="—" Margin="0,0,0,0"/>
            </Grid>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="ConnectBtn" Content="连  接" Width="120" Height="38" Margin="0,0,12,0"
                    FontSize="14" FontWeight="SemiBold" Click="ConnectBtn_Click"/>
            <Button x:Name="DisconnectBtn" Content="断  开" Width="120" Height="38"
                    FontSize="14" FontWeight="SemiBold" Click="DisconnectBtn_Click"/>
        </StackPanel>

        <!-- 设置 -->
        <Expander Grid.Row="4" Header="设置（首次使用需填邀请码）" Foreground="#E6E8EF" Background="Transparent" IsExpanded="False">
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="邀请码（由管理员单独发给你，勿外传）" Foreground="#9AA0AC" FontSize="12" Margin="0,0,0,6"/>
                <TextBox x:Name="InviteBox" Height="30" FontSize="13" Background="#232733"
                         Foreground="#E6E8EF" BorderBrush="#3A3F4D" VerticalContentAlignment="Center"/>
                <Button x:Name="SaveBtn" Content="保存邀请码" Width="110" Height="30" Margin="0,10,0,0"
                        HorizontalAlignment="Left" Click="SaveBtn_Click"/>
                <TextBlock x:Name="SvcInfoText" Text="服务地址：—" Foreground="#707684" FontSize="11"
                           Margin="0,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Expander>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="5" Text="关闭窗口将最小化到托盘；退出请使用托盘图标右键菜单。"
                   Foreground="#707684" FontSize="11" TextWrapping="Wrap"/>
    </Grid>
</Window>
